# ===========================================
# OntoCast — minimal configuration
#
# The variables below are the ones worth a decision. `.env.example` has ~150
# more; they have defaults that are fine until you have a measured reason to
# move them.
#
# Convention, as in `.env.example`: an uncommented line is one you should look
# at; `#VAR=value` is optional and the value shown is the default.
#
# Copy this to .env, set LLM_API_KEY, and run. Then pick a playbook:
# https://growgraph.github.io/ontocast/user_guide/playbooks/
# ===========================================


# -- 1. Identity and inputs ----------------------------------------------
# Base for every IRI OntoCast mints. Change it per project, not per run:
# it ends up baked into the graphs you have already written.
CURRENT_DOMAIN=https://example.com

# Seed ontologies (.ttl), synced into the catalog on startup. Extraction
# quality depends on this more than on any other setting in this file --
# an empty catalog means the model invents a schema from scratch.
ONTOCAST_ONTOLOGY_DIRECTORY=/path/to/ontology/files

# Cache root for LLM responses and converted documents. Defaults to the
# platform cache directory when unset.
#ONTOCAST_CACHE_DIR=/path/to/cache/directory


# -- 2. LLM ---------------------------------------------------------------
LLM_PROVIDER=openai                  # openai | ollama | anthropic | google
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.0                  # leave at 0.0; extraction is not a creative task

# Concurrent requests to the provider, shared across all content units. Lower
# it when you hit rate limits -- this is the knob for that, not PARALLEL_WORKERS.
LLM_MAX_INFLIGHT=16

# Responses are cached on disk, so re-running a document after changing a
# downstream setting is nearly free. Changing the prompt, model, or wire format
# invalidates the entries. Disable only to force fresh generations.
#LLM_CACHE_ENABLED=true
#LLM_REQUEST_TIMEOUT_SECONDS=180


# -- 3. What the pipeline does -------------------------------------------
# The two coarsest controls in the system. See the playbooks before changing
# either; each skips work the other half depends on.

# ontology          -> build/extend a schema; writes NO facts
# facts             -> populate instances against the catalog you already have;
#                      runs no ontology stage, so it adds no new terms
# ontology_and_facts-> both (default)
RENDER_MODE=ontology_and_facts

# Where each content unit's schema comes from:
# selected_single_ontology        -> LLM picks one catalog ontology per unit.
#                                   No infrastructure. Costs +1 LLM call per unit.
# selected_vector_search_ontology -> hybrid retrieval over an indexed catalog.
#                                   Needs section 7. Only mode that runs the
#                                   consistency critic.
# fixed_single_ontology           -> pin one ontology for the whole run.
ONTOLOGY_CONTEXT_MODE=selected_single_ontology

# Only for fixed_single_ontology. WARNING: setting this to anything non-empty
# FORCES fixed mode, silently overriding ONTOLOGY_CONTEXT_MODE above.
#ONTOLOGY_CONTEXT_FIXED_ONTOLOGY_ID=            # IRI, ontology_id, or author prefix

# Wire encoding the LLM emits graphs in. `turtle` is the legacy alternative,
# worth trying if a provider's structured output handles strings better.
LLM_GRAPH_FORMAT=jsonld              # jsonld | turtle


# -- 4. Cost and quality --------------------------------------------------
# Render/critic retry budget. At 1 (default) the LLM critic never runs.
# Raising it is the first thing to try when extractions are structurally poor;
# it costs roughly one extra call per unit per increment.
MAX_VISITS_PER_NODE=1

# Extra bounded repair calls per facts unit, driven by machine-found
# violations. Fires even at MAX_VISITS_PER_NODE=1, so a facts unit costs up to
# two provider calls by default. Set 0 for exactly one call per unit.
FACTS_LLM_REPAIR_VISITS=1

# Concurrent content-unit workers. Bounded in practice by LLM_MAX_INFLIGHT
# above; raising this alone will not make a rate-limited run faster.
PARALLEL_WORKERS=16

# Similarity for merging entities across units. Raise it if distinct things
# are being merged; lower it if duplicates survive.
AGG_SIMILARITY_THRESHOLD=0.80


# -- 5. Conversion and chunking ------------------------------------------
# Chunk size bounds in characters. Raise MAX to give each LLM call more
# context (fewer, larger units); lower it if the model loses the thread.
CHUNK_MIN_SIZE=3000
CHUNK_MAX_SIZE=12000

# semantic (default) splits at detected section boundaries and semantic-chunks
# within, so a chunk never straddles sections. docling uses HybridChunker
# structural segments instead.
#CHUNK_SEGMENTER=semantic

# Section classification, in increasing cost. `llm` is the only tier that spends
# provider calls; `off` also disables section filters and schema exclusions.
#CHUNK_SECTION_CLASSIFIER=heuristic   # off | heading | heuristic | llm

# Reference lists are not domain content. skip (default) drops them;
# citations_only extracts bibliographic metadata instead.
#CHUNK_BIBLIOGRAPHY_MODE=skip         # skip | citations_only | domain_facts

# For publisher PDFs with selectable text: born_digital switches the backend and
# repairs ligature gaps ("di ff usion"). Try it before reaching for OCR settings.
#CONVERTER_PROFILE=default            # default | born_digital


# -- 6. Local embedding models (memory) ----------------------------------
# Three settings each name a local sentence-transformer, and they default to
# TWO DIFFERENT checkpoints -- so a default run holds two resident models.
# Setting all three to one string collapses them onto one (~650 MB less peak
# RSS, measured). The cache key is the literal string, so spellings must match
# exactly: a bare name and a prefixed one load twice despite being the same
# checkpoint. Keep the `sentence-transformers/` prefix everywhere.
#
# Changing CHUNK_EMBEDDING_MODEL is not free: it invalidates the chunk cache,
# shifts chunk boundaries, and moves the calibrated schema-detection
# thresholds. See docs/user_guide/performance.md#local-embedding-models.
AGG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#CHUNK_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2


# -- 7. Vector retrieval --------------------------------------------------
# ONLY needed for ONTOLOGY_CONTEXT_MODE=selected_vector_search_ontology.
# Ignore this whole block otherwise -- nothing here is read, and the vector
# store is not even constructed.
#
# Pick exactly one backend; setting both is an error.
#QDRANT_URI=http://localhost:6333    # server; also QDRANT_API_KEY if secured
#LANCEDB_ENABLED=true                # embedded; uv sync --extra lancedb

# Must match the model that indexed the catalog. Changing either invalidates
# the index -- reindex with VECTOR_STORE_WIPE_ON_INIT=true or --wipe-vector-store.
#EMBEDDING_PROVIDER=huggingface
#EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#EMBEDDING_DIMENSION=384

# How much schema each unit is shown. The two knobs that actually move recall.
#VECTOR_STORE_TOP_K=20
#VECTOR_STORE_INDUCED_SUBGRAPH_MAX_TOTAL_TRIPLES=1200

# Drop and rebuild the partition on startup. Required after any change to the
# embedding contract above.
#VECTOR_STORE_WIPE_ON_INIT=false


# -- 8. Ontology context size (prompt budget) -----------------------------
# THE knob for context blow-up. Triple budget for the ontology serialized into
# every prompt, in every ontology_context_mode. Over budget, the least
# load-bearing triples go first -- header/list noise, then redundant structure,
# then comments and definitions. Labels, types, hierarchy and domain/range are
# never dropped, so a catalog that cannot fit is passed through with a WARNING
# rather than silently gutted. That warning means "split the catalog or switch
# to vector mode", not "raise this number".
#
# Rough cost: ~50 chars/triple in turtle, ~103 in jsonld. So 4000 triples is
# ~51k tokens turtle, ~103k jsonld.
ONTOLOGY_CONTEXT_MAX_TRIPLES=4000

# In vector mode the retrieved subgraph is capped BEFORE it reaches the budget
# above -- VECTOR_STORE_INDUCED_SUBGRAPH_MAX_TOTAL_TRIPLES in section 7 (default
# 1200). That is a growth budget during expansion, not a final ceiling: the
# small-module closure runs afterwards and can add whole modules past it, so the
# budget above is what actually bounds the prompt in every mode.
#
# The other big lever is the wire format, not a size knob: LLM_GRAPH_FORMAT in
# section 3. `jsonld` costs ~103 chars/triple against ~50 for `turtle`, so
# switching halves the context with no change to extraction semantics.

# Hard cap on retrieved atoms per unit (vector mode only). Lower it for noisy
# catalogs where irrelevant terms crowd out the right ones.
#ONTOLOGY_PATCH_MAX_ATOMS=96

# NOT a context knob, despite the name -- it is a runaway-growth backstop on the
# per-unit ontology working graph, skipping whole updates that would exceed it.
# Unset (unlimited) by default.
#ONTOLOGY_MAX_TRIPLES=


# -- 9. Facts validation --------------------------------------------------
# LLM-free repair of SHACL violations at the validation gate. Never invents data.
FACTS_SHACL_AUTOFIX=prune            # prune | rewrite | off

# Point at your domain catalog's shapes directory to enforce value-shape
# contracts after merging. Needs `uv sync --extra shacl`; inline sh:NodeShape
# triples already in the ontology context are honoured without it.
#FACTS_SHAPES_DIR=/path/to/shapes


# -- 10. Web grounding ----------------------------------------------------
# Off by default, and the ~20 other WEB_SEARCH_* knobs are inert until it is on.
# "Search-later": nodes run without search and only search when they ask to.
# Enabling it is also what makes a raised MAX_VISITS_PER_NODE expensive.
#WEB_SEARCH_ENABLED=false


# -- 11. Storage and serving ---------------------------------------------
# Omit FUSEKI_URI entirely for in-memory pyoxigraph -- correct for trying
# OntoCast out and for single-shot batch runs. Nothing persists.
#FUSEKI_URI=http://localhost:3030
#FUSEKI_AUTH=admin/admin

# With --input-path: flush the configured scope before processing. Destructive.
#CLEAN=false

# The server has NO authentication and POST /flush is destructive. Keep the
# loopback default unless it sits behind a proxy that authenticates.
HOST=127.0.0.1
PORT=8999

# Queues requests beyond the limit rather than rejecting them.
#MAX_CONCURRENT_PROCESSES=4

LOGGING_LEVEL=info                   # debug | info | warning | error
