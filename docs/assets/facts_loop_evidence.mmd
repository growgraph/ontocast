---
config:
  flowchart:
    curve: basis
    htmlLabels: true
    useMaxWidth: true
  look: handDrawn
  theme: base
  themeVariables:
    fontFamily: '''Architects Daughter'', cursive'
    fontSize: 20px
    lineColor: '#FFAB91'
    primaryBorderColor: '#143642'
    primaryColor: '#FFF3E0'
    primaryTextColor: '#372237'
---

flowchart TD;
	start([Unit start])
	ctx[Resolve / apply<br/>ontology context]
	render_loop{failed render<br/>1 … MAX_VISITS}
	render_facts[Render facts]
	pass_loop{critic pass<br/>1 … FACTS_CRITIC_PASSES}
	findings[Deterministic checks<br/>(no LLM call)]
	criticise_facts[Criticise facts<br/>(cites statement ids)]
	patch[Compile, screen, apply<br/>patch (no LLM call)]
	converged{changed nothing, or<br/>rolled back?}
	done([Return unit state])
	exhausted([Return (retries exhausted)])
	render_fail_search{initiate_search?}
	evid_r[Plan + fetch<br/>web evidence]
	rerender[Re-render facts]
	critic_fail_search{initiate_search?}
	evid_c[Plan + fetch<br/>web evidence]
	recritic[Re-criticise facts]
	start --> ctx;
	ctx --> render_loop;
	render_loop --> render_facts;
	render_facts -.->|success| pass_loop;
	render_facts -.->|fail| render_fail_search;
	render_fail_search -.->|yes| evid_r;
	evid_r --> rerender;
	rerender -.->|success| pass_loop;
	rerender -.->|fail| render_loop;
	render_fail_search -.->|no| render_loop;
	render_loop -.->|exhausted| exhausted;
	pass_loop -.->|pass| findings;
	findings --> criticise_facts;
	criticise_facts -.->|accept| patch;
	criticise_facts -.->|reject| critic_fail_search;
	critic_fail_search -.->|yes| evid_c;
	evid_c --> recritic;
	recritic -.->|accept or reject| patch;
	critic_fail_search -.->|no| patch;
	patch --> converged;
	converged -.->|yes| done;
	converged -.->|no| pass_loop;
	pass_loop -.->|budget spent| done;
