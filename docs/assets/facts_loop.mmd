---
config:
  flowchart:
    curve: basis
    htmlLabels: true
    useMaxWidth: true
  look: handDrawn
  theme: base
  themeVariables:
    fontFamily: '''Architects Daughter'', cursive'
    fontSize: 20px
    lineColor: '#FFAB91'
    primaryBorderColor: '#143642'
    primaryColor: '#FFF3E0'
    primaryTextColor: '#372237'
---

flowchart TD;
	start([Unit start])
	ctx[Resolve / apply<br/>ontology context]
	render_loop{failed render<br/>1 … MAX_VISITS}
	render_facts[Render facts]
	pass_loop{critic pass<br/>1 … FACTS_CRITIC_PASSES}
	findings[Deterministic checks<br/>(no LLM call)]
	criticise_facts[Criticise facts<br/>(cites statement ids)]
	patch[Compile, screen, apply<br/>patch (no LLM call)]
	converged{no fix kept, and a rollback<br/>or no mandatory findings left?}
	done([Return unit state])
	exhausted([Return (retries exhausted)])
	skip_critic{citation metadata, or fewer than<br/>FACTS_CRITIC_MIN_TRIPLES triples?}
	completion[Completion passes<br/>0 … FACTS_COMPLETION_PASSES<br/>(insert-only)]
	start --> ctx;
	ctx --> render_loop;
	render_loop --> render_facts;
	render_facts -.->|success| pass_loop;
	render_facts -.->|fail| render_loop;
	render_loop -.->|exhausted| exhausted;
	pass_loop -.->|pass| findings;
	findings --> skip_critic;
	criticise_facts -.->|accept or reject| patch;
	patch --> converged;
	converged -.->|yes| completion;
	converged -.->|no| pass_loop;
	pass_loop -.->|budget spent| completion;
	skip_critic -.->|no| criticise_facts;
	skip_critic -.->|yes (no critic call)| completion;
	criticise_facts -.->|unavailable (no patch)| completion;
	completion --> done;
