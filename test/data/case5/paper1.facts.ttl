    sosa:featureOfInterest doc:cdseSuperlattice ;
    sosa:hasResult doc:val_edge_length_3 ;
    sosa:observedProperty matsci:edgeLengthProperty .

doc:obs_fwhm_1 a obs:QuantitativeObservation ;
    rdfs:label "FWHM observation of CsPbBr3 NC batch"^^xsd:string,
        "PL peak wavelength observation of CsPbBr3 NC batch"^^xsd:string,
        "Observation of PL red shift in aggregates of SLs"@en,
        "Observation of PL red shift in isolated SLs"@en,
        "Observation of impurity contribution to PL red shift"@en,
        "Observation of self-absorption contribution to PL red shift in macroscopic sample"@en,
        "PL FWHM observation of NC solution in ODE"@en,
        "PL FWHM observation of drop-casted NC film"@en,
        "PL FWHM observation of isolated NC SLs"@en,
        "PL peak energy observation of NC solution in ODE"@en,
        "PL peak energy observation of drop-casted NC film"@en,
        "PL peak energy observation of isolated NC SLs"@en,
        "PL peak wavelength observation at n = 1"@en,
        "PL peak wavelength observation at n = 30"@en,
        "PL peak wavelength observation of NC solution in ODE"@en,
        "PL peak wavelength observation of drop-casted NC film"@en,
        "PL peak wavelength observation of isolated NC SLs"@en,
        "PL peak wavelength of SL1"@en,
        "PL peak wavelength of SL2"@en,
        "PL peak wavelength of SL3"@en,
        "PL peak wavelength of individual SL"@en,
        "PL red shift energy observation of individual SLs"@en,
        "PL red shift observation of SL3"@en,
        "PL red shift wavelength observation of individual SLs"@en ;
    sosa:featureOfInterest doc:cdseSuperlattice,
        doc:sl_sample_1 ;
    sosa:hasFeatureOfInterest doc:bulklike_cspbbr3_impurity,
        doc:cdseSuperlattice,
        doc:ncBatch,
        doc:sample_1,
        doc:sample_2,
        doc:sample_3,
        doc:sample_sl3 ;
    sosa:hasResult doc:sizeLowerBound,
        doc:valPlPeakIndividual,
        doc:val_fwhm_3 ;
    sosa:observedProperty matsci:fwhmProperty,
        matsci:plPeakWavelengthProperty,
        matsci:stokesShiftProperty ;
    obs:hasQuantityResult doc:fwhm_value_1,
        doc:pl_peak_value_1,
        doc:range_energy_1,
        doc:range_fwhm_1,
        doc:range_rs_wl_1,
        doc:range_wl_1,
        doc:val_energy_3,
        doc:val_fwhm_3,
        doc:val_rs_sl3,
        doc:val_wl_3 ;
    obs:usesMethod matsci:Photoluminescence .

