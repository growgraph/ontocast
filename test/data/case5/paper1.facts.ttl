        doc:liberatoManna,
        doc:muhammadImran,
        doc:stefanoToso ;
    schema:name "The formation of cesium lead bromide (CsPbBr 3 ) nanocrystal superlattices (NC SLs) is accompanied by a red shift in the NC photoluminescence (PL)"@en .

doc:methanol a matsci:Material ;
    rdfs:label "methanol"@en .

