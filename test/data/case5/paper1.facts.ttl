doc:obsCleanRedShift a sosa:Observation ;
    rdfs:label "PL red shift observation of aggregated SL"^^xsd:string,
        "PL red shift observation of clean SL"^^xsd:string,
        "Observation of PL red shift from self-absorption"@en,
        "Observation of PL red shift in SLs with impurities"@en,
        "Observation of PL red shift in clean SLs"@en,
        "Observation of overall PL red shift"@en ;
    sosa:hasFeatureOfInterest doc:cdseSuperlattice,
        doc:individualCleanSl,
        doc:sample_sl3 ;
    sosa:hasResult doc:redShiftCleanVal,
        doc:valCleanRedShift ;
    sosa:observedProperty matsci:stokesShiftProperty .

doc:obsFwhmNc a sosa:Observation ;
    rdfs:label "SL dimension observation"^^xsd:string,
        "PL FWHM observation of NCs in solution"@en,
        "PL FWHM observation of SL aggregates"@en,
        "PL peak wavelength observation of NCs in solution"@en,
        "PL peak wavelength observation of SL aggregates"@en ;
    sosa:hasFeatureOfInterest doc:ncSampleInSolution,
        doc:sample_sl3,
        doc:superlatticeSample ;
    sosa:hasResult doc:slDimensionVal ;
    sosa:observedProperty matsci:fwhmProperty,
        matsci:plPeakWavelengthProperty ;
    obs:hasQuantityResult doc:sizeLowerBound,
        doc:val_fwhm_3 .

doc:obsShapeFlat a obs:Observation ;
    rdfs:label "Shape observation of CsPbBr3 NC batch"^^xsd:string,
        "Observation of CsPbBr3 nanocrystal shape"@en,
        "Observation of shape for biggest CsPbBr3 NC SLs"@en,
        "Observation of shape for flat SLs"@en,
        "Observation of supraparticle shape"@en ;
    sosa:featureOfInterest doc:cdseSuperlattice,
        doc:ncSlSampleFlat ;
    sosa:hasFeatureOfInterest doc:cuboidalSupraparticles,
        doc:ncBatch ;
    sosa:hasResult doc:cube,
        doc:cubicShapeResult,
        doc:cuboidalShapeResult,
        doc:shapeFlat,
        doc:shapeIsotropic ;
    sosa:observedProperty matsci:shapeProperty .

doc:obs_edge_length_3 a obs:QuantitativeObservation ;
