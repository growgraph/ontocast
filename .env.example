# ===========================================
# OntoCast Environment Configuration
# Copy this file to .env and update with your values
#
# This is the COMPLETE surface -- around 200 variables. If you are setting
# OntoCast up for the first time, start from `.env.example.minimal` (47
# variables, grouped by decision) and the playbooks:
# https://growgraph.github.io/ontocast/user_guide/playbooks/
# ===========================================

# Domain Configuration
# Used for URI generation in the knowledge graph
CURRENT_DOMAIN=https://example.com

# Server Configuration
PORT=8999
BASE_RECURSION_LIMIT=1000
ESTIMATED_CHUNKS=30
MAX_VISITS=1
# Which halves of the pipeline run. `ontology` stops after the ontology block and
# writes no facts; `facts` skips the ontology block entirely and extracts only
# against the catalog you already have. Overridable per request.
RENDER_MODE=ontology_and_facts                       # ontology | facts | ontology_and_facts

# Wire encoding the LLM uses for RDF graph payloads. `turtle` is the legacy
# encoding, kept for providers whose structured output handles strings more
# reliably than nested objects.
LLM_GRAPH_FORMAT=jsonld                              # jsonld | turtle

# Where the per-unit schema shown to the LLM comes from. `selected_single_ontology`
# spends one extra LLM call per content unit to pick a catalog ontology;
# `selected_vector_search_ontology` needs a vector backend (QDRANT_URI or
# LANCEDB_ENABLED) and is the only mode that runs the consistency critic.
ONTOLOGY_CONTEXT_MODE=selected_single_ontology       # selected_single_ontology | selected_vector_search_ontology | fixed_single_ontology
# Setting this to a non-empty value FORCES fixed_single_ontology, whatever
# ONTOLOGY_CONTEXT_MODE says above.
#ONTOLOGY_CONTEXT_FIXED_ONTOLOGY_ID=my_ontology_id   # IRI, ontology_id, or author prefix
# Triple budget for the ontology context serialized into each prompt, in every
# ontology_context_mode. Over budget, the least load-bearing triples go first
# (header/list noise, then redundant structure, then comments and definitions);
# labels, types, hierarchy and domain/range are never dropped, so a graph that
# cannot fit is passed through with a warning rather than silently gutted.
ONTOLOGY_CONTEXT_MAX_TRIPLES=4000

# NOT a context bound -- a runaway-growth backstop on the per-unit ontology
# working graph, all-or-nothing, unset (unlimited) by default. Use
# ONTOLOGY_CONTEXT_MAX_TRIPLES above for prompt size.
#ONTOLOGY_MAX_TRIPLES=
PARALLEL_WORKERS=16
ENABLE_ONTOLOGY_CONSOLIDATION=false

# LLM Configuration
# Available providers: openai, ollama, anthropic, google
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_API_KEY=your_openai_api_key_here
# LLM_CACHE_ENABLED=true
# LLM_CACHE_READ_ONLY=false
# LLM_MAX_INFLIGHT=16
# MAX_CONCURRENT_PROCESSES=4

# Ollama Configuration (Alternative)
# LLM_PROVIDER=ollama
# LLM_MODEL_NAME=llama3.1
# LLM_BASE_URL=http://localhost:11434
# LLM_TEMPERATURE=0.0

# Anthropic Claude (Alternative)
# LLM_PROVIDER=anthropic
# LLM_MODEL_NAME=claude-sonnet-4-20250514
# LLM_API_KEY=your_anthropic_api_key_here
# LLM_TEMPERATURE=0.0

# Google Gemini (Alternative)
# LLM_PROVIDER=google
# LLM_MODEL_NAME=gemini-2.0-flash
# LLM_API_KEY=your_google_api_key_here
# LLM_TEMPERATURE=0.0

# Chunking Configuration
CHUNK_MIN_SIZE=3000
CHUNK_MAX_SIZE=12000
CHUNK_SECTION_TAG_MIN_CHARS=80
# The local sentence-transformer backing semantic chunking and schema detection.
# At its default this is a SECOND resident model alongside AGG_EMBEDDING_MODEL /
# EMBEDDING_MODEL_NAME, because it names a different checkpoint (mpnet-base,
# ~1.1 GB, vs MiniLM ~458 MB). Setting all three to the same string collapses
# them onto one model (~650 MB less peak RSS, measured) -- the prefix is part of
# the string SharedEncoder caches on, so the spellings must match exactly.
# Not a free win: changing it invalidates the chunk cache, shifts chunk
# boundaries, and moves the calibrated CHUNK_SECTION_SCHEMA_DETECT_* thresholds.
# See docs/user_guide/performance.md#local-embedding-models.
# CHUNK_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Segmenter: semantic (default; sections-first — split at detected section
# boundaries, semantic chunking within) or docling (HybridChunker structural
# segments).
# CHUNK_SEGMENTER=semantic
# Chunk section classification cascade, in increasing cost: off (no tagging;
# disables section filters and schema default exclusions such as academic
# acknowledgements/appendix), heading (document outline plus heading
# pattern/keyword matching), heuristic (default; heading plus content-density
# classification for unheaded regions), llm (heuristic plus a batched LLM pass
# over whatever remains unlabeled -- the only tier that costs LLM calls).
# CHUNK_SECTION_CLASSIFIER=heuristic
# Content-density tier: labels unheaded regions by embedding similarity to each
# schema's section descriptions. off | conservative (default) | aggressive.
# CHUNK_SECTION_DENSITY=conservative
# What to do when a section selection (target_sections / summarize_sections, or
# the exclude_sections denylist including a schema's default_exclude) removes
# every segment. warn (default) logs and continues to an empty graph, which
# reads exactly like a document with nothing to extract; error fails the run
# instead -- HTTP 422, and a non-zero exit for `ontocast process`.
# CHUNK_SECTION_FILTER_ON_EMPTY=warn
# Excerpts per LLM call when CHUNK_SECTION_CLASSIFIER=llm; 0 restores per-chunk
# calls.
# CHUNK_SECTION_LLM_BATCH_SIZE=40
# Document-type schema detection tier: off | lexical | headings (default) |
# auto (headings plus the content-embedding tier).
# CHUNK_SECTION_SCHEMA_DETECT=headings
# Detection thresholds, calibrated against the reference corpus in
# test/data/schema_corpus.json. Below the floor the detector abstains and the
# manifest default is used; the margins decide how far ahead the winner must be.
# CHUNK_SECTION_SCHEMA_DETECT_MIN_SCORE=2.0
# CHUNK_SECTION_SCHEMA_DETECT_MIN_MARGIN=1.8
# CHUNK_SECTION_SCHEMA_DETECT_CONTENT_MIN_MARGIN=4.0
# Treat bold/emphasised lines in markdown as headings, for documents whose
# structure never became real heading levels during conversion.
# CHUNK_SECTION_TEXT_HEADINGS=true
# Reference-list routing: skip (default) drops the chunks; citations_only
# extracts bibliographic metadata only; domain_facts is the legacy behavior.
# Every routing decision is logged, since a false positive silences a section.
# Detection is subject-domain-agnostic but English/Latin-script bound.
# CHUNK_BIBLIOGRAPHY_MODE=skip
# Terms the citation-metadata prompt uses in citations_only mode. Bibliographic
# entries are not domain content, so these are configuration, not retrieval.
# Override for catalogs modelling citations with bibo, FaBiO, DCMI, etc.
# CHUNK_CITATION_VOCABULARY={"work_class": "schema:ScholarlyArticle", "fallback_class": "schema:CreativeWork", "title": "schema:name", "author": "schema:author", "author_name": "schema:name", "date_published": "schema:datePublished", "venue": "schema:isPartOf", "identifier": "schema:identifier", "cites": "schema:citation"}

# Docling converter configuration
# Use born_digital for publisher PDFs with selectable text and ligature-gap issues.
# CONVERTER_PROFILE=born_digital
# CONVERTER_PDF_BACKEND=pypdfium2
# CONVERTER_DO_OCR=false
# CONVERTER_DO_TABLE_STRUCTURE=true
# CONVERTER_FORCE_BACKEND_TEXT=true
# CONVERTER_TABLE_CELL_MATCHING=true
# CONVERTER_LAYOUT_MODEL=heron
# CONVERTER_OCR_ENGINE=auto
# CONVERTER_OCR_LANG=
# CONVERTER_FORCE_FULL_PAGE_OCR=false
# CONVERTER_OCR_BITMAP_AREA_THRESHOLD=0.05
# TEMP workaround for publisher-PDF ligature splits.
# CONVERTER_REPAIR_LIGATURE_GAPS=true

# Triple Store Configuration
# Omit FUSEKI_URI for the default in-memory pyoxigraph backend (process lifetime).
# Set FUSEKI_URI (+ FUSEKI_AUTH) for persistent Apache Fuseki.
# When FUSEKI_DATASET is unset, names derive from default tenant/project (ontocast/test).

# Fuseki Configuration (optional — production)
# Server root only — SPARQL is at {FUSEKI_URI}/{dataset}/sparql (not the UI link "#/dataset/…").
# The bundled docker/fuseki compose maps the server to host port 3032.
FUSEKI_URI=http://localhost:3030
FUSEKI_AUTH=admin/admin
#FUSEKI_DATASET=ontocast--test--facts
#FUSEKI_ONTOLOGIES_DATASET=ontocast--test--ontologies

# Path Configuration
ONTOCAST_ONTOLOGY_DIRECTORY=/path/to/ontology/files
# optional; uses platform cache directory when unset
ONTOCAST_CACHE_DIR=/path/to/cache/directory
# LLM cache retention: size ceiling (bytes or '1GB'-style; 0 disables
# eviction), entry TTL in days (unset disables the age cut), and how many
# cache writes between prune sweeps.
# ONTOCAST_CACHE_MAX_BYTES=1GB
# ONTOCAST_CACHE_TTL_DAYS=30
# ONTOCAST_CACHE_PRUNE_EVERY=256

# Aggregation (entity disambiguation across chunks)
# One of the three local sentence-transformer settings (with CHUNK_EMBEDDING_MODEL
# and EMBEDDING_MODEL_NAME). SharedEncoder keys its process-wide cache on the
# literal string, so the `sentence-transformers/` prefix is load-bearing: the same
# checkpoint written two ways loads twice. Align all three to hold one resident
# model instead of two (~650 MB measured) -- see docs/user_guide/performance.md.
AGG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Cosine threshold of the cross-graph EntityAligner (/align_entities,
# match-graphs). The in-pipeline aggregator does NOT read it -- it clusters and
# gates at AGG_CANDIDATE_SIMILARITY_THRESHOLD.
AGG_SIMILARITY_THRESHOLD=0.80
# Merge-guard tunables (thresholds for the lexical tiers and corpus inferences)
# AGG_CANDIDATE_SIMILARITY_THRESHOLD=0.70
# AGG_LEXICAL_LABEL_JACCARD=0.5
# AGG_LEXICAL_SEQUENCE_RATIO=0.90
# AGG_LEXICAL_TOKEN_JACCARD=0.75
# AGG_FUNCTIONAL_MIN_EMPIRICAL_SUPPORT=2
# AGG_SIBLING_GUARD_SCOPE=subject  # or predicate
# Guard/evidence toggles (ablation arms; all default on except the strict mode)
# AGG_LITERAL_CONFLICT_GUARD=true    # veto merges on disjoint literal values
# AGG_INITIALS_DISTINCT_GUARD=true   # veto labels differing only by initials
# AGG_NATURAL_KEY_MERGE=true         # merge pull from shared identifier values
# AGG_TYPE_GUARD_UNTYPED=permissive  # or strict: typed-vs-untyped fails closed

# Embedding provider (vector store / retrieval)
EMBEDDING_PROVIDER=huggingface
# Keep the `sentence-transformers/` prefix -- see the AGG_EMBEDDING_MODEL note.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSION=384
# Asymmetric retrieval models need distinct query/document instructions; the default
# paraphrase model is symmetric and wants neither. Both are part of the stored embedding
# contract, so changing either requires --wipe-vector-store.
#   BAAI/bge-*: EMBEDDING_QUERY_PREFIX='Represent this sentence for searching relevant passages: '
#   intfloat/e5-*: EMBEDDING_QUERY_PREFIX='query: '  EMBEDDING_DOCUMENT_PREFIX='passage: '
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=

# Qdrant connection (optional; use QDRANT_URI or LANCEDB_ENABLED, not both)
QDRANT_URI=http://localhost:6333
QDRANT_API_KEY=abc123-qwe
# Default collections derive from tenant/project ontocast/test when unset.
QDRANT_GRPC_PORT=6334
QDRANT_USE_GRPC=false

# Vector store retrieval (backend-agnostic; applies to Qdrant and LanceDB)
# Legacy QDRANT_TOP_K / QDRANT_INDUCED_SUBGRAPH_* names are ignored — use VECTOR_STORE_*.
# Backend selection: auto (default; Qdrant if QDRANT_URI is set, LanceDB if
# enabled, otherwise vector retrieval is disabled), qdrant, lancedb, none.
# VECTOR_STORE_BACKEND=auto
VECTOR_STORE_TOP_K=20
VECTOR_STORE_INDUCED_SUBGRAPH_DEPTH=2
VECTOR_STORE_INDUCED_SUBGRAPH_MAX_TOTAL_TRIPLES=1200
VECTOR_STORE_INDUCED_SUBGRAPH_ESTIMATED_TRIPLES_PER_QUERY=24
# VECTOR_STORE_INDUCED_SUBGRAPH_HUB_SEED_COUNT=16
# VECTOR_STORE_INDUCED_SUBGRAPH_ANCESTOR_CLOSURE_DEPTH=3
# VECTOR_STORE_INDUCED_SUBGRAPH_CANDIDATE_PUSHDOWN=false
# VECTOR_STORE_INDUCED_SUBGRAPH_TYPE_PROMOTION_SCORE_FACTOR=1.0
# VECTOR_STORE_INDUCED_SUBGRAPH_SEED_ORDER=score  # or ontology_round_robin
# VECTOR_STORE_PROPOSITION_WINDOW_SENTENCES=2
# VECTOR_STORE_PROPOSITION_MAX_WINDOWS=16
# VECTOR_STORE_PROPOSITION_RETRIEVAL_ENABLED=true
# VECTOR_STORE_CONSISTENCY_CRITIC_MIN_FUSED_SCORE=0.5
# VECTOR_STORE_EMBEDDING_BATCH_SIZE=64
# VECTOR_STORE_REINDEX_CONCURRENCY=2
# VECTOR_STORE_WIPE_ON_INIT=false
# VECTOR_STORE_PRUNE_ORPHAN_IRIS_ON_INIT=true
# Lexical-trigger lane (exact-match unit symbols, formulae, etc.)
# VECTOR_STORE_LEXICAL_TRIGGER_ENABLED=true
# VECTOR_STORE_LEXICAL_TRIGGER_HEURISTIC_ENABLED=true
# VECTOR_STORE_LEXICAL_TRIGGER_MIN_LEN=2
# VECTOR_STORE_LEXICAL_TRIGGER_MAX_LEN=24
# VECTOR_STORE_LEXICAL_TRIGGER_HEURISTIC_MAX_PER_ENTITY=2
# VECTOR_STORE_LEXICAL_TRIGGER_MAX_ATOMS=16
# VECTOR_STORE_LEXICAL_TRIGGER_SCORE=0.35
# VECTOR_STORE_LEXICAL_TRIGGER_FUSION=max_merge  # or append (legacy)
# Query-side unit signals: number-adjacent tokens ("4-15 days", "200 kV", "0.5 %")
# matched case-insensitively/plural-tolerantly against catalog surfaces; matched
# entities join the seeds outside the semantic budget. Default off pending the
# recall sweep.
# VECTOR_STORE_QUERY_UNIT_SIGNALS_ENABLED=false

# Facts rendering post-checks and repair
# FACTS_OBJECT_PROPERTY_LITERAL_CHECK=true
# Finding-driven repair renders per unit -- each one is a PROVIDER CALL. Only
# MANDATORY findings trigger one (advisory numeric-coverage gaps ride along but
# never fire it on their own). Fires even at MAX_VISITS=1, where the LLM critic
# never runs, so the default costs up to two calls per unit; 0 disables.
# FACTS_LLM_REPAIR_VISITS=1
# FACTS_PROPERTY_ALIAS_MIN_RATIO=0.85
# Predicates whose literals are machine-resolvable codes: a node carrying
# qudt:ucumCode "d" and no unit link gains qudt:unit unit:DAY when exactly one
# catalog individual declares that code. JSON array of predicate IRIs.
# FACTS_CODE_PREDICATES=["http://qudt.org/schema/qudt/ucumCode","http://qudt.org/schema/qudt/symbol","http://www.w3.org/2004/02/skos/core#notation"]
# Post-aggregation validation gate (VALIDATE_FACTS node): un-merge budget for
# merge-signature error findings on merged subjects (functional violation,
# suspect multi-value, degenerate coreference -- never SHACL); 0 records
# findings without repairing. A pass is kept only if it strictly reduces them.
# FACTS_MERGE_REPAIR_PASSES=1
# FACTS_SUSPECT_MULTI_VALUE_SEVERITY=error  # or warning
# Collapse duplicate literals differing only in language tag or datatype
# ("X"@en / "X"^^xsd:string / "X") before validation; lang-tagged form wins.
# FACTS_LITERAL_VARIANT_DEDUPE=true
# Which critic-proposed fix severities block a unit from leaving the
# render/critic loop. Deterministic mandatory findings always block; this is
# the cut applied to the LLM critic's own severity label, which is model output
# from a field description with no rubric. Measured on the 2026-08 matsci
# corpus the critic emitted 27 'critical' fixes against 99 'important', so
# 'important' accepts 3 of 26 renders -- worse than the score threshold it
# replaced. 'never' lets deterministic findings gate alone.
# FACTS_ACCEPT_BLOCKING_SEVERITY=critical  # or important, never
# Distinct single-valued subjects before a predicate counts as functional.
# FACTS_FUNCTIONAL_MIN_SINGLE_SUPPORT=3
# SHACL lane needs `uv sync --extra shacl`; inline sh:NodeShape triples in the
# ontology context are picked up without this. Setting the dir without the
# extra installed, or pointing it at a missing/empty dir, logs a WARNING.
# Point it at your domain catalog's shapes directory to enforce value-shape
# contracts post-merge (e.g. matsci-perovskite-ontologies/shapes rejects exact
# scalars encoded as equal or one-sided bounds).
# FACTS_SHAPES_DIR=/path/to/shapes
# The ontology context is mixed into the data graph (a catalog individual's
# type is stated only in the catalog) and RDFS inference is on, because SHACL
# property paths carry no subPropertyOf entailment.
# FACTS_SHACL_INFERENCE=rdfs   # none | rdfs | owlrl
# FACTS_SHACL_ADVANCED=true
# FACTS_SHACL_MAX_TRIPLES=200000   # skip with a warning above this; 0 = no cap
# LLM-free repair of SHACL violations: off | rewrite | prune. 'rewrite' retypes
# literals and resolves codes to catalog IRIs; 'prune' also drops minCount
# violators that assert nothing (rdf:type/rdfs:label only). Never invents data.
# FACTS_SHACL_AUTOFIX=prune
# FACTS_SHACL_AUTOFIX_PASSES=1

# Vocabulary the facts prompt names as the fallback for bounded/approximate
# quantities when retrieval supplied no suitable class. JSON object keyed by
# role (value_class, numeric_value, unit). Defaults to QUDT. Set to {} to
# forbid the fallback and keep the renderer inside the provided context.
# FACTS_QUANTITY_FALLBACK_VOCABULARY={"value_class": "qudt:QuantityValue", "numeric_value": "qudt:numericValue", "unit": "qudt:unit"}
# Namespaces exempt from UNKNOWN_TERM beyond the RDF/OWL substrate. Only
# meta-vocabularies are built in; domain vocabularies (SOSA/SSN, CSVW, FOAF)
# are exempted here. schema.org is the default because CHUNK_CITATION_VOCABULARY
# uses it.
# FACTS_ADDITIONAL_STANDARD_NAMESPACES=["https://schema.org/", "http://schema.org/"]

# Embedded LanceDB alternative (optional; local directory via lancedb.connect)
# LANCEDB_ENABLED=true
# LANCEDB_DATA_DIR=~/.lancedb_data

# Ontology patch retrieval (default: max_score dedupe → global score order → window-scaled cap)
# A per-ontology seed quota of 0 means no round-robin; set >0 to cap seeds per ontology.
ONTOLOGY_PATCH_CROSS_QUERY_MERGE_MODE=max_score
ONTOLOGY_PATCH_PER_ONTOLOGY_SEED_QUOTA=0
ONTOLOGY_PATCH_SEEDS_PER_WINDOW=4
ONTOLOGY_PATCH_MAX_ATOMS_BASE=96
ONTOLOGY_PATCH_MAX_ATOMS=96
ONTOLOGY_PATCH_MIN_MERGED_MAX_SCORE=0.18
ONTOLOGY_PATCH_MMR_LAMBDA=1.0
# Snapshot-adequacy mechanisms. Values below are the shipped defaults, chosen by
# a one-axis-at-a-time sweep on the 8-module matsci catalog (see the retrieval
# tuning table in docs/user_guide/configuration.md for the measured ranges).
#
# ATOM_FLOOR reserves N seed slots per contributing ontology before the global
# fill (a floor, unlike the SEED_QUOTA ceiling), so a small module cannot be
# starved by a dominant one. SMALL_MODULE_CLOSURE then includes such a module's
# whole graph -- a qualified-quantity or observation vocabulary is only useful
# whole, and partial inclusion is what produces near-miss property invention
# (qqval:lowerBound for hasLowerBound, or schema:hasPart for hasQuantityResult).
# The closure is INERT unless the module wins at least one seed, so raising it
# without ATOM_FLOOR >= 1 does nothing. Set the closure above your largest
# must-have module (measured: 300 covers a 256-triple module, 0 disables).
# ONTOLOGY_PATCH_PER_ONTOLOGY_ATOM_FLOOR=2
# ONTOLOGY_PATCH_SMALL_MODULE_CLOSURE_MAX_TRIPLES=300
# Reserve seed slots for predicate-role atoms; prose reads as noun phrases, so
# classes win a shared ranking and the properties that link them get crowded out.
# ONTOLOGY_PATCH_PER_ROLE_ATOM_FLOOR=12
# Admit properties whose rdfs:domain/range names an admitted class (and the
# domain/range classes of admitted properties). A class with nothing to link it
# is inert context. 0 disables.
# ONTOLOGY_PATCH_SCHEMA_CLOSURE_MAX_ENTITIES=32
# ONTOLOGY_PATCH_SCHEMA_CLOSURE_ANCESTOR_DEPTH=2
# Advanced precision knobs (off by default):
# ONTOLOGY_PATCH_PER_QUERY_CORE_SCORE_RATIO=0.0
# ONTOLOGY_PATCH_PER_QUERY_NEIGHBORHOOD_SCORE_RATIO=0.0
# ONTOLOGY_PATCH_PER_QUERY_BM25_SCORE_RATIO=0.0
# ONTOLOGY_PATCH_MERGED_SCORE_RATIO=0.0
# ONTOLOGY_PATCH_MAX_ATOMS_TIER1=12
# ONTOLOGY_PATCH_MIN_ENTITY_SCORE=0.3

# Web grounding (search-later: nodes run without search first)
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TOP_K=3
WEB_SEARCH_TIMEOUT_SECONDS=8.0
WEB_SEARCH_MAX_SNIPPET_CHARS=400
WEB_SEARCH_MAX_TOTAL_CHARS=1800
WEB_SEARCH_ONTOLOGY_RENDER_ENABLED=true
WEB_SEARCH_ONTOLOGY_CRITIC_ENABLED=true
WEB_SEARCH_FACTS_RENDER_ENABLED=false
WEB_SEARCH_FACTS_CRITIC_ENABLED=false
WEB_SEARCH_PLANNER_ENABLED=true
WEB_SEARCH_PLANNER_MAX_QUERIES=3
WEB_SEARCH_PLANNER_MIN_QUERY_CHARS=12
WEB_SEARCH_PLANNER_MIN_CONFIDENCE=0.35
WEB_SEARCH_REUSE_EVIDENCE_ACROSS_ATTEMPT=true
WEB_SEARCH_MIN_SNIPPET_CHARS=40
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_BLOCKED_DOMAINS=
WEB_SEARCH_REGION=wt-wt
WEB_SEARCH_SAFESEARCH=moderate

# Additional Configuration
# With --input-path: if true, flush triple store (configured scope) before processing.
CLEAN=false
LOGGING_LEVEL=info

# ---------------------------------------------------------------------------
# Advanced knobs
# ---------------------------------------------------------------------------
# All commented out: each line shows the default. Uncomment only to diverge.

# Server bind interface. Defaults to loopback because the server has no
# authentication and /flush is destructive; set 0.0.0.0 for containers.
# HOST=127.0.0.1

# Resident per-tenant/project ToolBoxes (LRU-evicted; the expensive tools are
# shared across scopes).
# MAX_TENANCY_SCOPES=16

# Per-request provider LLM timeout in seconds.
# LLM_REQUEST_TIMEOUT_SECONDS=180

# Render attempts per unit loop. At 1 the LLM critic never runs (the single
# render is also the final one). Raise to 2+ to enable the critic pass.
# MAX_VISITS_PER_NODE=1

# Critic attempts per render attempt. Unset couples it to MAX_VISITS_PER_NODE,
# whose worst case is that value squared in billed critic calls -- reachable
# only when the critic keeps requesting external evidence (WEB_SEARCH_ENABLED),
# since a critic that fails without a search request breaks out of the loop.
# Set to 1 to cap that path. No effect unless MAX_VISITS_PER_NODE>=2.
# MAX_CRITIC_VISITS_PER_NODE=

# LLM provider extras. THINK / NUM_PREDICT / NUM_CTX apply to Ollama only.
# LLM_THINK=
# LLM_NUM_PREDICT=
# LLM_NUM_CTX=
# Concurrent in-flight LLM calls (alias: MAX_INFLIGHT).
# LLM_MAX_INFLIGHT=16

# Sparse (BM25) embedding model for the lexical lane.
# EMBEDDING_BM25_MODEL_NAME=Qdrant/bm25

# --- Hybrid fusion weights -------------------------------------------------
# How the three retrieval lanes are combined. Raising the BM25 weight helps
# corpora queried by symbol/notation rather than by prose label.
# VECTOR_STORE_FUSION_CORE_WEIGHT=0.7
# VECTOR_STORE_FUSION_NEIGHBORHOOD_WEIGHT=0.15
# VECTOR_STORE_FUSION_BM25_WEIGHT=0.8

# --- What gets indexed (changing any of these requires a reindex) ----------
# Surface forms read from the graph. The symbol list is the indexing half of
# the contract whose retrieval half is INDUCED_SUBGRAPH_SYMBOL_PREDICATES;
# keep the two in agreement.
# VECTOR_STORE_LABEL_PREDICATES=["http://www.w3.org/2000/01/rdf-schema#label","http://www.w3.org/2004/02/skos/core#prefLabel","http://purl.org/dc/terms/title","http://www.w3.org/2004/02/skos/core#altLabel","http://purl.org/dc/terms/alternative"]
# VECTOR_STORE_SYMBOL_PREDICATES=["http://www.w3.org/2004/02/skos/core#notation","http://qudt.org/schema/qudt/symbol","http://qudt.org/schema/qudt/ucumCode"]
# VECTOR_STORE_INDUCED_SUBGRAPH_SYMBOL_PREDICATES=["http://www.w3.org/2004/02/skos/core#notation","http://qudt.org/schema/qudt/symbol","http://qudt.org/schema/qudt/ucumCode"]
# VECTOR_STORE_LEXICAL_TRIGGER_PREDICATES=["http://www.w3.org/2004/02/skos/core#notation","http://qudt.org/schema/qudt/symbol","http://qudt.org/schema/qudt/ucumCode"]
# Aliases folded into the sparse representation per term.
# VECTOR_STORE_MINIMAL_LABEL_LIMIT=5
# Atomize IRIs the graph only references (default off: they become retrieval hubs).
# VECTOR_STORE_INDEX_UNDESCRIBED_IRIS=false
# Atomize standard vocabulary namespaces (rdf/rdfs/owl/skos/...).
# VECTOR_STORE_EMBED_STANDARD_VOCAB_IRIS=false
# VECTOR_STORE_EXTRA_EXCLUDED_NAMESPACE_PREFIXES=[]

# Prose "meV" would otherwise retrieve symbol "MeV" -- one token, 10^9 error.
# VECTOR_STORE_SYMBOL_CASE_MISMATCH_POLICY=demote
# VECTOR_STORE_SYMBOL_CASE_MISMATCH_DEMOTE_FACTOR=0.5

# --- Relative score floors (0 disables; all off by default) ----------------
# ONTOLOGY_PATCH_MIN_CORE_QUERY_BEST_SCORE=0.0
# ONTOLOGY_PATCH_MIN_NEIGHBORHOOD_QUERY_BEST_SCORE=0.0
# ONTOLOGY_PATCH_MIN_BM25_QUERY_BEST_SCORE=0.0
# Dump per-ontology ranking diagnostics into retrieval metrics.
# ONTOLOGY_PATCH_DUMP_ONTOLOGY_RANKS=false

# --- Deduplication of indexed atoms ---------------------------------------
# VECTOR_STORE_DEDUP_MODE=iri
# VECTOR_STORE_DEDUP_INCLUDE_VERSION=true
# VECTOR_STORE_DEDUP_INCLUDE_HASH=true
# VECTOR_STORE_DEDUP_QUERY_HITS_BY_IRI=true

# --- Collection / table names (derived from tenant+project when unset) -----
# VECTOR_STORE_ONTOLOGY_TABLE=
# VECTOR_STORE_FACTS_TABLE=
# QDRANT_ONTOLOGY_COLLECTION=
# QDRANT_FACTS_COLLECTION=
# LANCEDB_ONTOLOGY_TABLE=
# LANCEDB_FACTS_TABLE=

# --- Qdrant connection -----------------------------------------------------
# QDRANT_VECTOR_SIZE must equal EMBEDDING_DIMENSION when set.
# QDRANT_VECTOR_SIZE=
# QDRANT_DISTANCE=Cosine
# QDRANT_UPSERT_BATCH_SIZE=256
# QDRANT_TIMEOUT_SECONDS=30
